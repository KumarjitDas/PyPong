#  PyInstaller; be sure to clean them up if you don't want them.
*.manifest
*.spec

# Build artifacts:
*.lib
*.exp
*.obj
*.pyd
*.dll

# IDEs and editors
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS or system files
.DS_Store
